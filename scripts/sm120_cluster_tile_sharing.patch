+// Thread-block cluster helpers (distributed shared memory) for the cluster tile sharing of `sm120_fp8_fp4_gemm_1d1d_impl`
+namespace sm120_cluster {
+
+/// The shared::cluster address, in CTA `rank` of the cluster, of the shared::cta address `smem_addr`
+CUTLASS_DEVICE uint32_t map_to_rank(const uint32_t& smem_addr, const uint32_t& rank) {
+    uint32_t result;
+    asm volatile("mapa.shared::cluster.u32 %0, %1, %2;" : "=r"(result) : "r"(smem_addr), "r"(rank));
+    return result;
+}
+
+/// Arrive on an mbarrier of a (possibly remote) CTA, releasing this thread's earlier shared memory reads at cluster scope
+CUTLASS_DEVICE void arrive_release_cluster(const uint32_t& cluster_barrier_addr) {
+    asm volatile("mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%0];" :: "r"(cluster_barrier_addr) : "memory");
+}
+
+/// Wait for a phase of a local mbarrier that remote CTAs arrive on (acquire at cluster scope)
+CUTLASS_DEVICE void wait_acquire_cluster(const uint32_t& barrier_addr, const uint32_t& parity) {
+    asm volatile("{\n\t"
+                 ".reg .pred p;\n\t"
+                 "WAIT_LOOP:\n\t"
+                 "mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 p, [%0], %1;\n\t"
+                 "@!p bra WAIT_LOOP;\n\t"
+                 "}" :: "r"(barrier_addr), "r"(parity) : "memory");
+}
+
+/// 16 bytes of a peer's shared memory (a shared::cluster address)
+CUTLASS_DEVICE uint4 load_from_peer(const uint32_t& peer_addr) {
+    uint4 value;
+    asm volatile("ld.shared::cluster.v4.b32 {%0, %1, %2, %3}, [%4];"
+                 : "=r"(value.x), "=r"(value.y), "=r"(value.z), "=r"(value.w) : "r"(peer_addr) : "memory");
+    return value;
+}
+
+CUTLASS_DEVICE void store_shared(const uint32_t& addr, const uint4& value) {
+    asm volatile("st.shared.v4.b32 [%0], {%1, %2, %3, %4};" :: "r"(addr), "r"(value.x), "r"(value.y), "r"(value.z), "r"(value.w) : "memory");
+}
+
+/// Barrier over every thread of every CTA of the cluster, ordering their shared memory accesses
+CUTLASS_DEVICE void sync_all() {
+    asm volatile("barrier.cluster.arrive.release;\n\tbarrier.cluster.wait.acquire;" ::: "memory");
+}
